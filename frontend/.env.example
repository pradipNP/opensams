# Copy this file to .env. Vite inlines VITE_API_URL at build time.
# Do not commit .env. Do not build production with a localhost API URL.

# LOCAL DEVELOPMENT (Vite default API when backend PORT=5001)
VITE_API_URL=http://localhost:5001/api/v1

# PRODUCTION (Cloudflare Pages / any static host — set in the host's env, then rebuild)
# VITE_API_URL=https://YOUR_API_HOST/api/v1
