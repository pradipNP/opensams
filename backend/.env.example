# Copy this file to .env and replace every placeholder.
# Do not commit .env. Do not use these values in production.

NODE_ENV=development
PORT=5000
APP_VERSION=1.0.0

# If port 5000 is already in use locally, set PORT=5001

# PostgreSQL connection string. Replace USER, PASSWORD, HOST, PORT, and DATABASE.
# Local Docker often publishes Postgres on host port 5433; production must use SSL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Example shapes (do not copy credentials from a live system):
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/DATABASE
# DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:5433/DATABASE
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required. Use a long unique random value. Never reuse a documented placeholder.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h

# Exact frontend origin (scheme + host, no path). Local Vite default is port 5173.
CORS_ORIGIN=http://localhost:5173

# Public portfolio demo only. When true, the API restores seed data on a timer
# (3 users, 27 schools, 500 assets). Leave unset/false on a real production system.
# DEMO_RESET_ENABLED=true
# DEMO_RESET_INTERVAL_HOURS=24
