NODE_ENV=development
PORT=5000
APP_VERSION=1.0.0

# If port 5000 is already in use locally, set PORT=5001

# Local host talking to Docker container sams_postgres (published on 5433)

# Local host talking to Docker container sams_postgres (published on 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sams_nepal

# Backend running inside Docker on Windows/macOS:
# DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5433/sams_nepal

# Neon (production)
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/sams_nepal?sslmode=require

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

CORS_ORIGIN=http://localhost:5173
