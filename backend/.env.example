# LOCAL DEVELOPMENT defaults. For production, set NODE_ENV=production
# and replace every value below. Do not reuse these secrets.
NODE_ENV=development
PORT=5000
APP_VERSION=1.0.0

# If port 5000 is already in use locally, set PORT=5001

# LOCAL: host talking to Docker container sams_postgres (published on 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sams_nepal

# LOCAL: backend running inside Docker on Windows/macOS
# DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5433/sams_nepal

# PRODUCTION (managed PostgreSQL). Always use SSL in production.
# DATABASE_URL=postgresql://user:pass@db-host/sams_nepal?sslmode=require

# PRODUCTION: use a long random secret. Never ship the development fallback.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

# LOCAL frontend origin. PRODUCTION: exact live frontend origin (scheme + host).
CORS_ORIGIN=http://localhost:5173
